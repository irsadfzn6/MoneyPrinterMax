# ==========================================
# MoneyPrinterMax Environment Variables
# ==========================================

# 1. Google Flow CDP Port (Default: 9222)
CHROME_CDP_PORT=9222

# 2. Text-to-Speech (TTS) Configuration
# Provider options: "cartesia", "elevenlabs", "edge-tts", or "auto"
TTS_PROVIDER=auto

# Cartesia AI (Optional, ultra-fast low latency)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=b2a6771c-0f34-432b-9cf2-fd22efd32e3b

# ElevenLabs (Optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Edge-TTS (100% FREE, No API Key needed!)
# Default Indonesian Voices: "id-ID-ArdiNeural" (Male), "id-ID-GadisNeural" (Female)
EDGE_TTS_VOICE=id-ID-ArdiNeural

# 3. Channel Branding
CHANNEL_NAME="Nalar Kosmik"
CHANNEL_WATERMARK="@nalarkosmik"

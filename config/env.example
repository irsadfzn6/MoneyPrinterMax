# ==========================================
# MoneyPrinterMax Environment Variables
# ==========================================

# 1. Google Flow CDP Port (Default: 9222)
CHROME_CDP_PORT=9222

# 2. Text-to-Speech (TTS) Configuration (WAJIB API Key & Voice ID)
# Pilihan provider: "cartesia" (Direkomendasikan) atau "elevenlabs"
TTS_PROVIDER=cartesia

# Cartesia AI (Default: Suara Victor / Kustom)
CARTESIA_API_KEY=sk_car_xxxxxxxxxxxxxxxxxxxx
CARTESIA_VOICE_ID=b2a6771c-0f34-432b-9cf2-fd22efd32e3b

# ElevenLabs (Opsional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# 3. Channel Branding
CHANNEL_NAME="Your Channel Name"
CHANNEL_WATERMARK="@yourchannel"
